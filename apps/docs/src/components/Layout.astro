---
// The page frame: skip link, top bar, grouped sidebar, the page, the "on
// this page" rail, previous and next, the footer and the search dialog.
// No client framework: public/docs.js adds the behavior.
import '../styles/docs.css';
import { ui, type Lang } from '../lib/i18n.ts';
import { galleryHref } from '../../scripts/gallery.ts';
import { config, href, navGroups, neighbours, sourceUrl, styles } from '../lib/site.ts';

export interface TocItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  lang: Lang;
  /** The page path without the language prefix, for example /components/button/. */
  path: string;
  title: string;
  description?: string;
  toc?: TocItem[];
  /** The Markdown twin of this page, a site path, when there is one. */
  twin?: string;
  /** Home: no sidebar highlight, no rail. */
  home?: boolean;
  /** The language the title is written in, when it differs from the page (component names). */
  titleLang?: Lang;
}

const { lang, path, title, description, toc = [], twin, home = false } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'en' ? 'ar' : 'en';
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const groups = navGroups();
const { prev, next } = neighbours(path);
const pageTitle = path === '/' ? `${config.name}` : `${title} | ${lang === 'ar' ? t.product : config.name}`;
const rail = toc.filter((h) => h.depth === 2 || h.depth === 3);
const isCurrent = (p: string) => p === path;
const label = (l: { en: string; ar: string }) => l[lang];
const galleryHome = galleryHref('/');
---

<!doctype html>
<html lang={lang} dir={dir} data-style="neutral" data-scheme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {path !== '/404/' && <link rel="alternate" hreflang={lang} href={href(lang, path)} />}
    {path !== '/404/' && <link rel="alternate" hreflang={other} href={href(other, path)} />}
    {twin && <link rel="alternate" type="text/markdown" href={twin} />}
    <script is:inline>
      // The scheme before the first paint: the saved choice, else the system setting.
      (() => {
        let s = null;
        try {
          s = localStorage.getItem('ds-docs-scheme');
        } catch {}
        if (s !== 'dark' && s !== 'light') s = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.scheme = s;
      })();
    </script>
    <script src="/docs.js" defer></script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="topbar">
      <div class="topbar-start">
        <button type="button" class="icon-btn menu-btn" data-menu aria-controls="sidebar" aria-expanded="false" aria-label={t.menu} data-label-open={t.menu} data-label-close={t.menuClose}>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </button>
        <a class="brand" href={href(lang, '/')}>
          <svg aria-hidden="true" class="brand-mark" viewBox="0 0 24 24" width="24" height="24"><rect x="3" y="3" width="8" height="8" rx="2" /><rect x="13" y="3" width="8" height="8" rx="4" /><rect x="3" y="13" width="8" height="8" rx="4" /><rect x="13" y="13" width="8" height="8" rx="2" /></svg>
          <span>{lang === 'ar' ? t.product : config.name}</span>
          <span class="version" dir="ltr">{config.version}</span>
        </a>
      </div>
      <button type="button" class="search-btn" data-search-open aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K /">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
        <span class="search-btn-text">{t.search}</span>
        <kbd aria-hidden="true" dir="ltr">Ctrl K</kbd>
      </button>
      <nav class="topnav" aria-label={t.mainNav}>
        <a href={href(lang, '/components/')} aria-current={path.startsWith('/components/') ? 'page' : undefined}>{t.nav.components}</a>
        <a href={href(lang, '/styles/')} aria-current={path.startsWith('/styles/') ? 'page' : undefined}>{t.nav.styles}</a>
        <a href={href(lang, '/platforms/')} aria-current={path === '/platforms/' ? 'page' : undefined}>{t.nav.platforms}</a>
        <a href={href(lang, '/interactions/')} aria-current={path === '/interactions/' ? 'page' : undefined}>{t.nav.interactions}</a>
      </nav>
      <div class="tools">
        <label class="style-pick">
          <span class="visually-hidden">{t.previewStyle}</span>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="16" height="16"><circle cx="8" cy="9" r="3.5" /><circle cx="16" cy="9" r="3.5" /><circle cx="12" cy="16" r="3.5" /></svg>
          <select data-style-select>
            {styles.map((s) => <option value={s.id} selected={s.id === 'neutral'}>{s.name}</option>)}
          </select>
        </label>
        <button type="button" class="icon-btn" data-scheme-toggle aria-label={t.schemeDark} data-label-dark={t.schemeDark} data-label-light={t.schemeLight}>
          <svg aria-hidden="true" class="when-light" viewBox="0 0 24 24" width="18" height="18"><path d="M20 14.5A8 8 0 0 1 9.5 4 8 8 0 1 0 20 14.5Z" /></svg>
          <svg aria-hidden="true" class="when-dark" viewBox="0 0 24 24" width="18" height="18"><circle cx="12" cy="12" r="4" /><path d="M12 2.5v2M12 19.5v2M2.5 12h2M19.5 12h2M5.3 5.3l1.4 1.4M17.3 17.3l1.4 1.4M5.3 18.7l1.4-1.4M17.3 6.7l1.4-1.4" /></svg>
        </button>
        <a class="lang-link" href={href(other, path === '/404/' ? '/' : path)} hreflang={other} lang={other}>{t.langOther}</a>
        {sourceUrl && <a class="icon-btn" href={sourceUrl}>Source</a>}
      </div>
    </header>

    <div class:list={['frame', { 'frame-home': home }]}>
      <nav id="sidebar" class="sidebar" aria-label={t.docsNav}>
        <label class="nav-style">
          <span>{t.previewStyle}</span>
          <select data-style-select>
            {styles.map((s) => <option value={s.id} selected={s.id === 'neutral'}>{s.name}</option>)}
          </select>
        </label>
        {groups.map((g) => (
          <section class="nav-group" aria-labelledby={`nav-${g.id}`}>
            <h2 class="nav-title" id={`nav-${g.id}`}>{label(g.label)}</h2>
            <ul>
              {g.links.map((l) => (
                <li>
                  <a href={href(lang, l.path)} aria-current={isCurrent(l.path) ? 'page' : undefined} lang={l.latin && lang === 'ar' ? 'en' : undefined}>{label(l.label)}</a>
                </li>
              ))}
            </ul>
            {g.sub?.map((s) => (
              <details class="nav-family" open={s.links.some((l) => isCurrent(l.path)) || undefined}>
                <summary>
                  {label(s.label)} <span class="count">{s.links.length}</span>
                </summary>
                <ul>
                  {s.links.map((l) => (
                    <li>
                      <a href={href(lang, l.path)} aria-current={isCurrent(l.path) ? 'page' : undefined} lang={lang === 'ar' ? 'en' : undefined}>{label(l.label)}</a>
                    </li>
                  ))}
                </ul>
              </details>
            ))}
          </section>
        ))}
      </nav>

      <main id="main" tabindex="-1">
        <slot />
        {!home && (prev || next) && (
          <nav class="pager" aria-label={`${t.previous}, ${t.next}`}>
            {prev ? (
              <a class="pager-link" href={href(lang, prev.path)} rel="prev">
                <span class="pager-dir">{t.previous}</span>
                <span class="pager-title" lang={prev.latin && lang === 'ar' ? 'en' : undefined}>{label(prev.label)}</span>
              </a>
            ) : <span />}
            {next && (
              <a class="pager-link pager-next" href={href(lang, next.path)} rel="next">
                <span class="pager-dir">{t.next}</span>
                <span class="pager-title" lang={next.latin && lang === 'ar' ? 'en' : undefined}>{label(next.label)}</span>
              </a>
            )}
          </nav>
        )}
      </main>

      {!home && rail.length > 1 && (
        <aside class="rail" aria-labelledby="rail-title">
          <h2 id="rail-title" class="rail-title">{t.onThisPage}</h2>
          <ul>
            {rail.map((h) => (
              <li class={`depth-${h.depth}`}>
                <a href={`#${h.slug}`} data-rail-link>{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </div>

    <footer class="footer">
      <p>{t.footer}</p>
      <ul>
        <li><a href="/llms.txt" dir="ltr">{t.footerLinks.llms}</a></li>
        {twin && <li><a href={twin}>{t.footerLinks.twin}</a></li>}
        <li><a href={galleryHome}>{t.footerLinks.gallery}</a></li>
        <li><span dir="ltr">{config.name} {config.version}</span></li>
      </ul>
    </footer>

    <dialog class="search" data-search aria-labelledby="search-title" data-index={lang === 'ar' ? '/search/ar.json' : '/search/en.json'} data-lang={lang} data-empty={t.searchEmpty} data-count-label={t.searchResults(0)}>
      <h2 id="search-title" class="visually-hidden">{t.searchDocs}</h2>
      <div class="search-bar">
        <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><circle cx="11" cy="11" r="6.5" /><path d="m16 16 4.5 4.5" /></svg>
        <input type="search" data-search-input role="combobox" aria-expanded="false" aria-controls="search-list" aria-autocomplete="list" aria-label={t.searchDocs} placeholder={t.searchPlaceholder} autocomplete="off" spellcheck="false" />
        <button type="button" class="icon-btn" data-search-close aria-label={t.searchClose}>
          <svg aria-hidden="true" viewBox="0 0 24 24" width="18" height="18"><path d="m6 6 12 12M18 6 6 18" /></svg>
        </button>
      </div>
      <ul id="search-list" class="search-list" role="listbox" aria-label={t.searchDocs}></ul>
      <p class="search-status" role="status" data-search-status></p>
      <p class="search-hint">{t.searchHint}</p>
    </dialog>
  </body>
</html>
