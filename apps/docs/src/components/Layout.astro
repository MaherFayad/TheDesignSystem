---
// The page frame: skip link, top bar, grouped sidebar, the page, the "on
// this page" rail, previous and next, the footer and the search dialog.
// No client framework: public/docs.js adds the behavior.
import '../styles/system.css';
import '../styles/docs.css';
import Menu from './Menu.astro';
import { chromeCss, iconMarkup, styleIds } from '../lib/chrome.ts';
import { ui, type Lang } from '../lib/i18n.ts';
import { galleryHref } from '../../scripts/gallery.ts';
import { config, href, navGroups, neighbours, sourceUrl, styles } from '../lib/site.ts';

export interface TocItem {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  lang: Lang;
  /** The page path without the language prefix, for example /components/button/. */
  path: string;
  title: string;
  description?: string;
  toc?: TocItem[];
  /** The Markdown twin of this page, a site path, when there is one. */
  twin?: string;
  /** Home: no sidebar highlight, no rail. */
  home?: boolean;
  /** The language the title is written in, when it differs from the page (component names). */
  titleLang?: Lang;
}

const { lang, path, title, description, toc = [], twin, home = false } = Astro.props;
const t = ui[lang];
const other: Lang = lang === 'en' ? 'ar' : 'en';
const dir = lang === 'ar' ? 'rtl' : 'ltr';
const groups = navGroups();
const { prev, next } = neighbours(path);
const pageTitle = path === '/' ? `${config.name}` : `${title} | ${lang === 'ar' ? t.product : config.name}`;
const rail = toc.filter((h) => h.depth === 2 || h.depth === 3);
const isCurrent = (p: string) => p === path;
const label = (l: { en: string; ar: string }) => l[lang];
const galleryHome = galleryHref('/');
const galleryBase = galleryHome.replace(/\/$/, '');
const styleItems = styles.map((s) => ({ value: s.id, label: s.name, lang: lang === 'ar' ? 'en' : undefined, badge: s.status === 'proposed' ? t.proposed : undefined }));
const schemeItems = (['system', 'light', 'dark'] as const).map((v) => ({ value: v, label: t.schemeValues[v] }));
const langPath = path === '/404/' ? '/' : path;
const langItems = [
  { value: 'en', label: 'English', lang: 'en', href: href('en', langPath), hreflang: 'en' },
  { value: 'ar', label: 'العربية', lang: 'ar', href: href('ar', langPath), hreflang: 'ar' },
];
// The current value of the site switches, shown from attributes on <html>
// that the head script sets before the first paint.
const switchCss = [
  ...styles.map((s) => `:root[data-style='${s.id}'] [data-setting='style'] .mv>[data-v='${s.id}']`),
  ...['system', 'light', 'dark'].map((v) => `:root[data-scheme-choice='${v}'] [data-setting='scheme'] .mv>[data-v='${v}']`),
].join(',') + '{visibility:visible}';
const headScript = `(() => {
  const r = document.documentElement;
  const ids = ${JSON.stringify(styleIds)};
  const get = (k) => { try { return localStorage.getItem(k); } catch { return null; } };
  const lang = get('ds-docs-lang');
  if ((lang === 'en' || lang === 'ar') && lang !== r.lang) {
    let inside = false;
    try { inside = document.referrer !== '' && new URL(document.referrer).origin === location.origin; } catch {}
    const alt = document.querySelector('link[rel="alternate"][hreflang="' + lang + '"]');
    if (!inside && alt) { location.replace(alt.href + location.search + location.hash); return; }
  }
  const q = new URLSearchParams(location.search);
  let style = q.get('style');
  if (!ids.includes(style)) style = get('ds-docs-style');
  if (!ids.includes(style)) style = ids.includes('neutral') ? 'neutral' : ids[0];
  let choice = get('ds-docs-scheme');
  if (choice !== 'dark' && choice !== 'light') choice = 'system';
  const scheme = choice === 'system' ? (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light') : choice;
  const platform = get('ds-docs-platform');
  r.dataset.style = style;
  r.dataset.scheme = scheme;
  r.dataset.schemeChoice = choice;
  r.dataset.platformChoice = platform === 'ios' || platform === 'android' ? platform : 'web';
})();`;
---

<!doctype html>
<html lang={lang} dir={dir} data-ds="theme" data-style="neutral" data-scheme="light" data-scheme-choice="system" data-platform-choice="web" data-density="default" data-contrast="default" data-platform="web" data-glass="regular" data-gallery={galleryBase}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    {description && <meta name="description" content={description} />}
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {path !== '/404/' && <link rel="alternate" hreflang={lang} href={href(lang, path)} />}
    {path !== '/404/' && <link rel="alternate" hreflang={other} href={href(other, path)} />}
    {twin && <link rel="alternate" type="text/markdown" href={twin} />}
    <script is:inline set:html={headScript} />
    <style is:inline set:html={`${chromeCss}\n${switchCss}`} />
    <script src="/docs.js" defer></script>
  </head>
  <body>
    <a class="skip" href="#main">{t.skip}</a>
    <header class="topbar">
      <div class="topbar-start">
        <button type="button" class="menu-btn" data-ds="icon-button" data-tone="neutral" data-emphasis="ghost" data-size="md" data-shape="default" data-menu aria-controls="sidebar" aria-expanded="false" aria-label={t.menu} data-label-open={t.menu} data-label-close={t.menuClose}>
          <span data-part="icon" set:html={iconMarkup('menu', 20)} />
        </button>
        <a class="brand" href={href(lang, '/')}>
          <svg aria-hidden="true" class="brand-mark" viewBox="0 0 24 24" width="24" height="24"><rect x="3" y="3" width="8" height="8" rx="2" /><rect x="13" y="3" width="8" height="8" rx="4" /><rect x="3" y="13" width="8" height="8" rx="4" /><rect x="13" y="13" width="8" height="8" rx="2" /></svg>
          <span>{lang === 'ar' ? t.product : config.name}</span>
          <span class="version" dir="ltr" data-ds="badge" data-tone="neutral" data-emphasis="outline" data-size="sm"><span data-part="label">{config.version}</span></span>
        </a>
      </div>
      <button type="button" class="search-btn" data-search-open aria-haspopup="dialog" aria-keyshortcuts="Control+K Meta+K /">
        <span set:html={iconMarkup('search', 16)} />
        <span class="search-btn-text">{t.search}</span>
        <kbd data-ds="kbd" data-size="xs" dir="ltr" aria-hidden="true"><kbd data-part="key">Ctrl</kbd><kbd data-part="key">K</kbd></kbd>
      </button>
      <nav class="topnav" aria-label={t.mainNav}>
        <div data-ds="tabs" data-emphasis="soft" data-size="md" data-orientation="horizontal">
          <div data-part="list">
            {[
              { p: '/components/', label: t.nav.components, on: path.startsWith('/components/') },
              { p: '/styles/', label: t.nav.styles, on: path.startsWith('/styles/') },
              { p: '/platforms/', label: t.nav.platforms, on: path === '/platforms/' },
              { p: '/interactions/', label: t.nav.interactions, on: path === '/interactions/' },
            ].map((n) => (
              <a data-part="trigger" href={href(lang, n.p)} data-state={n.on ? 'active' : 'inactive'} aria-current={n.on ? 'page' : undefined}>
                {n.on && <span data-part="indicator" aria-hidden="true" />}
                <span data-part="label">{n.label}</span>
              </a>
            ))}
          </div>
        </div>
      </nav>
      <div class="tools">
        <Menu id="site-style" setting="style" label={t.siteStyle} items={styleItems} value="neutral" icon="grid" />
        <Menu id="site-scheme" setting="scheme" label={t.scheme} items={schemeItems} value="system" icon="sun" iconDark="moon" compact />
        <Menu id="site-lang" setting="lang" label={t.language} items={langItems} value={lang} icon="language" compact />
        {sourceUrl && <a class="icon-btn" href={sourceUrl}>Source</a>}
      </div>
    </header>

    <div class:list={['frame', { 'frame-home': home }]}>
      <nav id="sidebar" class="sidebar" aria-label={t.docsNav}>
        <div class="nav-style">
          <Menu id="nav-style" setting="style" label={t.siteStyle} items={styleItems} value="neutral" icon="grid" align="start" showLabel />
        </div>
        {groups.map((g) => (
          <section class="nav-group" aria-labelledby={`nav-${g.id}`}>
            <h2 class="nav-title" id={`nav-${g.id}`}>{label(g.label)}</h2>
            <ul>
              {g.links.map((l) => (
                <li>
                  <a href={href(lang, l.path)} aria-current={isCurrent(l.path) ? 'page' : undefined} lang={l.latin && lang === 'ar' ? 'en' : undefined}>{label(l.label)}</a>
                </li>
              ))}
            </ul>
            {g.sub?.map((s) => (
              <details class="nav-family" open={s.links.some((l) => isCurrent(l.path)) || undefined}>
                <summary>
                  {label(s.label)} <span class="count">{s.links.length}</span>
                </summary>
                <ul>
                  {s.links.map((l) => (
                    <li>
                      <a href={href(lang, l.path)} aria-current={isCurrent(l.path) ? 'page' : undefined} lang={lang === 'ar' ? 'en' : undefined}>{label(l.label)}</a>
                    </li>
                  ))}
                </ul>
              </details>
            ))}
          </section>
        ))}
      </nav>

      <main id="main" tabindex="-1">
        <slot />
        {!home && (prev || next) && (
          <nav class="pager" aria-label={`${t.previous}, ${t.next}`}>
            {prev ? (
              <a class="pager-link" href={href(lang, prev.path)} rel="prev">
                <span class="pager-dir">{t.previous}</span>
                <span class="pager-title" lang={prev.latin && lang === 'ar' ? 'en' : undefined}>{label(prev.label)}</span>
              </a>
            ) : <span />}
            {next && (
              <a class="pager-link pager-next" href={href(lang, next.path)} rel="next">
                <span class="pager-dir">{t.next}</span>
                <span class="pager-title" lang={next.latin && lang === 'ar' ? 'en' : undefined}>{label(next.label)}</span>
              </a>
            )}
          </nav>
        )}
      </main>

      {!home && rail.length > 1 && (
        <aside class="rail" aria-labelledby="rail-title">
          <h2 id="rail-title" class="rail-title">{t.onThisPage}</h2>
          <ul>
            {rail.map((h) => (
              <li class={`depth-${h.depth}`}>
                <a href={`#${h.slug}`} data-rail-link>{h.text}</a>
              </li>
            ))}
          </ul>
        </aside>
      )}
    </div>

    <footer class="footer">
      <p>{t.footer}</p>
      <ul>
        <li><a href="/llms.txt" dir="ltr">{t.footerLinks.llms}</a></li>
        {twin && <li><a href={twin}>{t.footerLinks.twin}</a></li>}
        <li><a href={galleryHome}>{t.footerLinks.gallery}</a></li>
        <li><span dir="ltr">{config.name} {config.version}</span></li>
      </ul>
    </footer>

    <template id="copy-button"><button type="button" class="copy-btn" data-ds="button" data-tone="neutral" data-emphasis="soft" data-size="sm" data-shape="default"><span data-part="start" set:html={iconMarkup('copy', 16)} /><span data-part="label"></span></button></template>

    <dialog class="search" data-search aria-labelledby="search-title" data-index={lang === 'ar' ? '/search/ar.json' : '/search/en.json'} data-lang={lang} data-empty={t.searchEmpty} data-count-label={t.searchResults(0)}>
      <h2 id="search-title" class="visually-hidden">{t.searchDocs}</h2>
      <div class="search-bar">
        <span class="search-icon" set:html={iconMarkup('search', 16)} />
        <input type="search" data-search-input role="combobox" aria-expanded="false" aria-controls="search-list" aria-autocomplete="list" aria-label={t.searchDocs} placeholder={t.searchPlaceholder} autocomplete="off" spellcheck="false" />
        <button type="button" data-ds="icon-button" data-tone="neutral" data-emphasis="ghost" data-size="md" data-shape="default" data-search-close aria-label={t.searchClose}>
          <span data-part="icon" set:html={iconMarkup('close', 16)} />
        </button>
      </div>
      <ul id="search-list" class="search-list" role="listbox" aria-label={t.searchDocs}></ul>
      <p class="search-status" role="status" data-search-status></p>
      <p class="search-hint">{t.searchHint}</p>
    </dialog>
  </body>
</html>
