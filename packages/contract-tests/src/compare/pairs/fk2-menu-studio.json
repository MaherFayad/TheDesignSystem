        "border-radius",
        "border-width",
        "background-color",
        "box-shadow",
        "padding",
        "animation-duration",
        "animation-timing-function",
        { "id": "row height", "property": "height", "source": "[role='menuitem']", "system": "[role='menuitem']" },
        { "id": "row radius", "property": "border-radius", "source": "[role='menuitem']", "system": "[role='menuitem']" },
        { "id": "row text size", "property": "font-size", "source": "[role='menuitem']", "system": "[role='menuitem']" },
        { "id": "row weight", "property": "font-weight", "source": "[role='menuitem']", "system": "[role='menuitem']" },
        { "id": "row text colour", "property": "color", "source": "[role='menuitem']", "system": "[role='menuitem']" }
      ]
    }
  ],
  "allowed": []
