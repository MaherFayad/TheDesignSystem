{
  "font": {
    "size": {
      "3xs": {
        "$type": "dimension",
        "$value": {
          "value": 9,
          "unit": "px"
        },
        "$extensions": {
          "ds.fluid": {
            "min": 8,
            "max": 9,
            "minViewport": 380,
            "maxViewport": 1440
          }
        },
        "$description": "Studio only uses this for micro badges. Avoid for readable text."
      },
      "2xs": {
        "$type": "dimension",
        "$value": {
          "value": 10,
          "unit": "px"
        },
        "$extensions": {
          "ds.fluid": {
            "min": 9,
            "max": 10,
            "minViewport": 380,
            "maxViewport": 1440
          }
        }
      },
      "xs": {
        "$type": "dimension",
        "$value": {
          "value": 11,
          "unit": "px"
        },
        "$extensions": {
          "ds.fluid": {
            "min": 10,
            "max": 11,
            "minViewport": 380,
            "maxViewport": 1440
          }
        }
      },
      "s": {
        "$type": "dimension",
        "$value": {
          "value": 12,
          "unit": "px"
        },
        "$extensions": {
          "ds.fluid": {
            "min": 11,
            "max": 12,
            "minViewport": 380,
            "maxViewport": 1440
          }
        },
        "$description": "Default chrome size: buttons, menu items, tooltips, toasts."
      },
      "m": {
        "$type": "dimension",
        "$value": {
          "value": 13,
          "unit": "px"
        },
        "$extensions": {
          "ds.fluid": {
            "min": 12,
            "max": 13,
            "minViewport": 380,
            "maxViewport": 1440
          }
        }
      },
      "l": {
        "$type": "dimension",
        "$value": {
          "value": 14,
          "unit": "px"
        },
        "$extensions": {
          "ds.fluid": {
            "min": 13,
            "max": 14,
            "minViewport": 380,
            "maxViewport": 1440
          }
        },
        "$description": "Dialog titles, body copy in panels."
      },
      "xl": {
        "$type": "dimension",
        "$value": {
          "value": 16,
          "unit": "px"
        },
        "$extensions": {
          "ds.fluid": {
            "min": 14,
            "max": 16,
            "minViewport": 380,
            "maxViewport": 1440
          }
        }
      },
      "2xl": {
        "$type": "dimension",
        "$value": {
          "value": 18,
          "unit": "px"
        },
        "$extensions": {
          "ds.fluid": {
            "min": 16,
            "max": 18,
            "minViewport": 380,
            "maxViewport": 1440
          }
        }
      },
      "3xl": {
        "$type": "dimension",
        "$value": {
          "value": 20,
          "unit": "px"
        },
        "$extensions": {
          "ds.fluid": {
            "min": 18,
            "max": 20,
            "minViewport": 380,
            "maxViewport": 1440
          }
        }
      },
      "4xl": {
        "$type": "dimension",
        "$value": {
          "value": 24,
          "unit": "px"
        },
        "$extensions": {
          "ds.fluid": {
            "min": 20,
            "max": 24,
            "minViewport": 380,
            "maxViewport": 1440
          }
        }
      },
      "5xl": {
        "$type": "dimension",
        "$value": {
          "value": 28,
          "unit": "px"
        },
        "$extensions": {
          "ds.fluid": {
            "min": 24,
            "max": 28,
            "minViewport": 380,
            "maxViewport": 1440
          }
        }
      },
      "6xl": {
        "$type": "dimension",
        "$value": {
          "value": 40,
          "unit": "px"
        },
        "$extensions": {
          "ds.fluid": {
            "min": 32,
            "max": 40,
            "minViewport": 380,
            "maxViewport": 1440
          }
        }
      },
      "7xl": {
        "$type": "dimension",
        "$value": {
          "value": 56,
          "unit": "px"
        },
        "$extensions": {
          "ds.fluid": {
            "min": 40,
            "max": 56,
            "minViewport": 380,
            "maxViewport": 1440
          }
        }
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "menu": {
        "$type": "fontWeight",
        "$value": 560,
        "$description": "Menu items (variable font)."
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      },
      "bold": {
        "$type": "fontWeight",
        "$value": 700,
        "$description": "Buttons and dialog titles."
      }
    },
    "leading": {
      "tight": {
        "$type": "number",
        "$value": 1.2
      },
      "arabic": {
        "tight": {
          "$type": "number",
          "$value": 1.35,
          "$description": "Arabic line height for the tight step. From the :lang(ar) block."
        },
        "snug": {
          "$type": "number",
          "$value": 1.5,
          "$description": "Arabic line height for the snug step. From the :lang(ar) block."
        },
        "normal": {
          "$type": "number",
          "$value": 1.7,
          "$description": "Arabic line height for the normal step. From the :lang(ar) block."
        },
        "relaxed": {
          "$type": "number",
          "$value": 1.8,
          "$description": "Arabic line height for the relaxed step. From the :lang(ar) block."
        }
      },
      "snug": {
        "$type": "number",
        "$value": 1.35
      },
      "normal": {
        "$type": "number",
        "$value": 1.5
      },
      "relaxed": {
        "$type": "number",
        "$value": 1.6
      }
    },
    "tracking": {
      "caps": {
        "$type": "number",
        "$value": 0.07,
        "$extensions": {
          "ds.unit": "em"
        },
        "$description": "Uppercase widget titles."
      },
      "eyebrow": {
        "$type": "number",
        "$value": 0.12,
        "$extensions": {
          "ds.unit": "em"
        },
        "$description": "Dialog eyebrow."
      },
      "none": {
        "$type": "number",
        "$value": 0,
        "$extensions": {
          "ds.unit": "em"
        },
        "$description": "No letter spacing. Arabic text uses it for every tracked style."
      }
    }
  }
}
