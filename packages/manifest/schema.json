{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://the-system.local/manifest.schema.json",
  "title": "Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "kind",
    "family",
    "summary",
    "useWhen",
    "avoidWhen",
    "insteadUse",
    "frameworks",
    "since"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Z][A-Za-z0-9]*$"
    },
    "kind": {
      "enum": [
        "component",
        "pattern",
        "template"
      ]
    },
    "family": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 10
    },
    "useWhen": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "avoidWhen": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "insteadUse": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "anatomy": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9-]*$"
      }
    },
    "parts": {
      "description": "Named sub components that render a part, for example DialogTitle renders part title.",
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "slots": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "accepts"
        ],
        "properties": {
          "accepts": {
            "oneOf": [
              {
                "const": "any"
              },
              {
                "const": "text"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          },
          "max": {
            "type": "integer",
            "minimum": 1
          },
          "min": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    },
    "props": {
      "type": "object",
      "additionalProperties": {
        "oneOf": [
          {
            "type": "array",
            "items": {
              "type": "string"
            },
            "minItems": 1
          },
          {
            "type": "string",
            "enum": [
              "boolean",
              "string",
              "number",
              "node",
              "function",
              "object"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "type"
            ],
            "properties": {
              "type": {
                "oneOf": [
                  {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  {
                    "type": "string"
                  }
                ]
              },
              "default": {},
              "description": {
                "type": "string"
              },
              "required": {
                "type": "boolean"
              }
            }
          }
        ]
      }
    },
    "states": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "a11y": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": {
          "type": "string"
        },
        "focus": {
          "type": "string"
        },
        "keys": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "announce": {
          "type": "string"
        },
        "native": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accessibilityRole": {
              "type": "string"
            },
            "accessibilityState": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "en": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "ar": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        }
      }
    },
    "tokens": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "motion": {
      "type": "string",
      "description": "A pattern id from packages/motion/src/core.ts, or none. Written by scripts/gen-index.ts.",
      "enum": [
        "none",
        "fade-rise",
        "menu-scale",
        "dialog",
        "sheet",
        "toast",
        "accordion-height",
        "tab-indicator",
        "list-stagger",
        "drag-drop",
        "window-grow",
        "window-zoom",
        "window-minimize",
        "skeleton-shimmer",
        "spinner",
        "number-roll",
        "chart-draw",
        "thinking",
        "streaming-text",
        "fade",
        "press"
      ]
    },
    "frameworks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "react",
        "angular",
        "native"
      ],
      "properties": {
        "react": {
          "$ref": "#/definitions/framework"
        },
        "angular": {
          "$ref": "#/definitions/framework"
        },
        "native": {
          "$ref": "#/definitions/framework"
        }
      }
    },
    "styles": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "mistakes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "wrong",
          "right"
        ],
        "properties": {
          "wrong": {
            "type": "string"
          },
          "right": {
            "type": "string"
          }
        }
      }
    },
    "contract": {
      "description": "Hints for the generated contract suite.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "type": "string",
          "description": "Selector to click before the root is in the DOM."
        },
        "skipAxeRules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "optionalParts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "keys": {
          "type": "object",
          "description": "Key checks the generic ones do not cover, for example arrow keys.",
          "additionalProperties": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "expect"
            ],
            "properties": {
              "focus": {
                "type": "string",
                "description": "Selector inside the demo to focus first."
              },
              "case": {
                "type": "string",
                "description": "Demo case id to look in."
              },
              "physical": {
                "type": "boolean",
                "description": "For moves: the arrow names a screen direction, so ArrowRight moves right in rtl too. For a positioned object."
              },
              "open": {
                "type": "string",
                "description": "Selector inside the demo to click first, to open what the key acts on. With expect focus-returns, focus must be back on it after the key."
              },
              "expect": {
                "enum": [
                  "focus-moves",
                  "value-changes",
                  "state-changes",
                  "click",
                  "closes",
                  "moves",
                  "focus-returns"
                ]
              }
            }
          }
        },
        "opens": {
          "type": "string",
          "description": "The data-ds of the root the trigger opens when it is another component (a SplitButton opens a dropdown-menu). The open target size and open axe checks then run on that root."
        }
      }
    },
    "regions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "uses": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "data": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "since": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    }
  },
  "definitions": {
    "framework": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status"
      ],
      "properties": {
        "status": {
          "enum": [
            "ready",
            "planned",
            "not-applicable"
          ]
        },
        "behavior": {
          "type": "string"
        },
        "example": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      }
    }
  }
}
