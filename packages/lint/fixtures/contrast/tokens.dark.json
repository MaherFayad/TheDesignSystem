{
  "$description": "A tiny fake style that breaks the contrast gate on purpose.",
  "color": {
    "$type": "color",
    "bg": {
      "body": { "$value": { "colorSpace": "srgb", "components": [0, 0, 0], "alpha": 1, "hex": "#000000" } },
      "surface": { "$value": { "colorSpace": "srgb", "components": [0.106, 0.106, 0.106], "alpha": 1, "hex": "#1b1b1b" } }
    },
    "text": {
      "default": { "$value": { "colorSpace": "srgb", "components": [0.929, 0.929, 0.929], "alpha": 1, "hex": "#ededed" } },
      "muted": { "$value": { "colorSpace": "srgb", "components": [0.267, 0.267, 0.267], "alpha": 1, "hex": "#444444" } },
      "link": { "$value": "{color.text.default}" }
    },
    "material": {
      "glass": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.5, "hex": "#ffffff" } }
    },
    "border": {
      "control": { "$value": { "colorSpace": "srgb", "components": [1, 1, 1], "alpha": 0.1, "hex": "#ffffff" } }
    }
  }
}
