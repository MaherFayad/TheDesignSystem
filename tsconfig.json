{
  "extends": "./tsconfig.base.json",
  "include": [
    "scripts/**/*.ts",
    "packages/*/src/**/*.ts",
    "packages/*/src/**/*.tsx",
    "packages/*/*.ts",
    "packages/styles/*/*.ts",
    "apps/gallery-react/src/**/*.ts",
    "apps/gallery-react/src/**/*.tsx",
    "vitest.config.ts",
    "vitest.setup.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/dist",
    "packages/angular",
    "packages/charts-angular",
    "packages/ai-angular",
    "packages/native",
    "packages/charts-native",
    "packages/ai-native",
    "packages/styles/*/native"
  ]
}
